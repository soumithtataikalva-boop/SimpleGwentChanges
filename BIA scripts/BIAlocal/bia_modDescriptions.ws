@wrapMethod(CR4IngameMenu)
function SU_onMenuEntered(menu: string, out descriptors: array<SU_MenuDescriptor>) {
  wrappedMethod(menu, descriptors);

  if (menu == "BrothersInArms_Optional") {
    descriptors.PushBack(new BIA_OptionalMenuDescriptor in this);
  }
  else if (menu == "QuestTweaks") {
    descriptors.PushBack(new QUTW_MenuDescriptor in this);
  }
  else if (menu == "BoatRaces") {
    descriptors.PushBack(new BR_MenuDescriptor in this);
  }
   else if (menu == "WLC") {
    descriptors.PushBack(new WLC_MenuDescriptor in this);
  }
   else if (menu == "Events") {
    descriptors.PushBack(new EVENTS_MenuDescriptor in this);
  }
}